---
import { site } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="rule-t mt-24">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-10 md:flex-row md:items-end md:justify-between md:px-10"
  >
    <div class="space-y-2">
      {
        site.email && (
          <a
            href={`mailto:${site.email}`}
            class="block text-sm underline decoration-line underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
          >
            {site.email}
          </a>
        )
      }
      {site.location && <p class="text-sm text-muted">{site.location}</p>}
    </div>

    <div class="space-y-3 md:text-right">
      {
        site.social.length > 0 && (
          <ul class="flex gap-5 md:justify-end">
            {site.social.map((link) => (
              <li>
                <a
                  href={link.url}
                  rel="me noopener"
                  target="_blank"
                  class="label transition-colors hover:text-accent"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <p class="label">
        © {year} {site.name}{site.footer_note && <> · {site.footer_note}</>}
      </p>
    </div>
  </div>
</footer>
