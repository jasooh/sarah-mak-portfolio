---
import CmsImage from './CmsImage.astro';

interface Props {
  src?: string | null;
  caption?: string;
  scale?: string;
  kind?: 'drawing' | 'photo';
  aspect?: string;
  sizes?: string;
  priority?: boolean;
  class?: string;
  zoomable?: boolean;
}

const {
  src,
  caption,
  scale,
  kind = 'photo',
  aspect = '3 / 2',
  sizes,
  priority = false,
  class: className = '',
  zoomable = true,
} = Astro.props;

---

<figure class={className}>
  <div class="frame bg-paper p-4">
    <CmsImage
      src={src}
      alt={caption ?? ''}
      class="w-full"
      aspect={aspect}
      layout="full-width"
      sizes={sizes}
      priority={priority}
      zoomable={zoomable}
    />
  </div>

  {
    (caption || scale) && (
      <figcaption class="caption mt-3">
        {caption}
        {scale && <em>&nbsp;(scale {scale})</em>}
      </figcaption>
    )
  }
</figure>
