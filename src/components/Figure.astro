---
import CmsImage from './CmsImage.astro';

interface Props {
  src?: string | null;
  caption?: string;
  /** Falls back to the caption; set it when a figure has no caption. */
  alt?: string;
  scale?: string;
  kind?: 'drawing' | 'photo';
  aspect?: string;
  /** Pins the media to a fixed ratio, so a row of figures lines up. */
  ratio?: string;
  sizes?: string;
  priority?: boolean;
  class?: string;
  zoomable?: boolean;
}

const {
  src,
  caption,
  alt,
  scale,
  kind = 'photo',
  aspect = '3 / 2',
  ratio,
  sizes,
  priority = false,
  class: className = '',
  zoomable = true,
} = Astro.props;

---

<figure class={className}>
  <div class="frame bg-paper p-4">
    <div class:list={[ratio && 'overflow-hidden']} style={ratio && `aspect-ratio: ${ratio}`}>
      <CmsImage
        src={src}
        alt={alt ?? caption ?? ''}
        class:list={[
          ratio ? 'h-full w-full' : 'w-full',
          kind === 'drawing' ? 'object-contain' : 'object-cover',
        ]}
        aspect={ratio ?? aspect}
        layout="full-width"
        sizes={sizes}
        priority={priority}
        zoomable={zoomable}
        label={kind === 'drawing' ? 'Drawing pending' : 'Image pending'}
      />
    </div>
  </div>

  {
    (caption || scale) && (
      <figcaption class="caption mt-3">
        {caption}
        {scale && <em>&nbsp;(scale {scale})</em>}
      </figcaption>
    )
  }
</figure>
