---
import { Image, getImage } from 'astro:assets';
import { resolveImage } from '../lib/images';

interface Props {
  src?: string | null;
  alt?: string;
  class?: string;
  aspect?: string;
  layout?: 'constrained' | 'full-width' | 'fixed' | 'none';
  sizes?: string;
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  zoomable?: boolean;
}

const {
  src,
  alt = '',
  class: className = '',
  aspect = '4 / 3',
  layout,
  sizes,
  loading,
  priority = false,
  zoomable = false,
} = Astro.props;

const image = resolveImage(src);

const zoom =
  zoomable && image && image.format !== 'svg'
    ? await getImage({ src: image, width: Math.min(image.width, 2000) })
    : undefined;

if (src && !image) {
  console.warn(`[CmsImage] No file found in src/assets/media for "${src}".`);
}
---

{
  image ? (
    <Image
      src={image}
      alt={alt}
      class={className}
      layout={layout}
      sizes={sizes}
      loading={priority ? 'eager' : (loading ?? 'lazy')}
      fetchpriority={priority ? 'high' : undefined}
      data-zoom={zoom?.src}
      data-zoom-w={zoom?.attributes?.width ?? image.width}
      data-zoom-h={zoom?.attributes?.height ?? image.height}
    />
  ) : (
    <div
      class:list={['flex items-center justify-center bg-paper-sunk', className]}
      style={`aspect-ratio: ${aspect}`}
      aria-hidden="true"
    >
      <span class="label">Image</span>
    </div>
  )
}
