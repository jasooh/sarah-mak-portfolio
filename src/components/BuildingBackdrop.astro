---
import { MEMBERS, PANELS, iso } from '../lib/frame';

const lines = MEMBERS.map((m) => {
  const [x1, y1] = iso(...m.a);
  const [x2, y2] = iso(...m.b);
  return `M${x1.toFixed(1)},${y1.toFixed(1)} L${x2.toFixed(1)},${y2.toFixed(1)}`;
});

const quads = PANELS.map((p) => {
  const corners: [number, number, number][] = [
    [p.x0, p.y, p.z0],
    [p.x1, p.y, p.z0],
    [p.x1, p.y, p.z1],
    [p.x0, p.y, p.z1],
  ];
  return 'M' + corners.map((c) => iso(...c).map((n) => n.toFixed(1)).join(',')).join(' L') + ' Z';
});

const points = [
  ...MEMBERS.flatMap((m) => [iso(...m.a), iso(...m.b)]),
  ...PANELS.flatMap((p) => [iso(p.x0, p.y, p.z0), iso(p.x1, p.y, p.z1)]),
];
const xs = points.map((p) => p[0]);
const ys = points.map((p) => p[1]);
const pad = 4;
const box = [
  Math.min(...xs) - pad,
  Math.min(...ys) - pad,
  Math.max(...xs) - Math.min(...xs) + pad * 2,
  Math.max(...ys) - Math.min(...ys) + pad * 2,
].join(' ');
---

<div class="backdrop" transition:persist="backdrop" aria-hidden="true">
  <canvas class="backdrop-gl"></canvas>
  <svg viewBox={box} fill="none" preserveAspectRatio="xMidYMid meet">
    <g class="frame-panels">
      {quads.map((d) => <path d={d} />)}
    </g>
    <g class="frame-lines">
      {lines.map((d) => <path d={d} />)}
    </g>
  </svg>
</div>

<script>
  (function () {
    if (window.__backdrop) return;
    window.__backdrop = true;

    const host = document.querySelector('.backdrop');
    const canvas = document.querySelector('.backdrop-gl');
    if (!(host instanceof HTMLElement) || !(canvas instanceof HTMLCanvasElement)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    function routeName() {
      const path = location.pathname.replace(/\/+$/, '') || '/';
      return path === '/' ? 'home' : path.split('/')[1];
    }

    const idle = window.requestIdleCallback ?? ((fn) => setTimeout(fn, 400));
    idle(async () => {
      try {
        const { startBackdrop } = await import('../lib/backdrop');
        const setRoute = startBackdrop(canvas);
        if (!setRoute) return;
        host.classList.add('is-gl');
        setRoute(routeName());
        document.addEventListener('astro:after-swap', () => setRoute(routeName()));
      } catch {}
    });
  })();
</script>
