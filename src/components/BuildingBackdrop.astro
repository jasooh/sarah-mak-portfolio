---
import { FINE, GUIDES, MEMBERS, PANELS, TIER_LIFT, iso } from '../lib/frame';

/* The static drawing is the exploded state, as the thesis sheet is. */
const lift = (tier: number) => TIER_LIFT[tier];
const ROOF_TIER = TIER_LIFT.length - 1;

const at = (p: [number, number, number], tier: number) => iso(p[0], p[1] + lift(tier), p[2]);
const seg = (a: [number, number], b: [number, number]) =>
  `M${a[0].toFixed(1)},${a[1].toFixed(1)} L${b[0].toFixed(1)},${b[1].toFixed(1)}`;

const line = (m: (typeof MEMBERS)[number]) => seg(at(m.a, m.tier), at(m.b, m.tier));
const heavy = MEMBERS.filter((m) => !FINE.has(m.kind)).map(line);
const hairlines = MEMBERS.filter((m) => FINE.has(m.kind)).map(line);
const leaders = GUIDES.map((g) => seg(at(g.a, ROOF_TIER), at(g.b, ROOF_TIER - 1)));

const quads = PANELS.map((p) => {
  const corners: [number, number, number][] = [
    [p.x0, p.y, p.z0],
    [p.x1, p.y, p.z0],
    [p.x1, p.y, p.z1],
    [p.x0, p.y, p.z1],
  ];
  return 'M' + corners.map((c) => at(c, p.tier).map((n) => n.toFixed(1)).join(',')).join(' L') + ' Z';
});

const points = [
  ...MEMBERS.flatMap((m) => [at(m.a, m.tier), at(m.b, m.tier)]),
  ...PANELS.flatMap((p) => [at([p.x0, p.y, p.z0], p.tier), at([p.x1, p.y, p.z1], p.tier)]),
];
const xs = points.map((p) => p[0]);
const ys = points.map((p) => p[1]);
const pad = 4;
const box = [
  Math.min(...xs) - pad,
  Math.min(...ys) - pad,
  Math.max(...xs) - Math.min(...xs) + pad * 2,
  Math.max(...ys) - Math.min(...ys) + pad * 2,
].join(' ');
---

<div class="backdrop" transition:persist="backdrop" aria-hidden="true">
  <canvas class="backdrop-gl"></canvas>
  <svg viewBox={box} fill="none" preserveAspectRatio="xMidYMid meet">
    <g class="frame-panels">
      {quads.map((d) => <path d={d} />)}
    </g>
    <g class="frame-lines">
      {heavy.map((d) => <path d={d} />)}
    </g>
    <g class="frame-lines frame-fine">
      {hairlines.map((d) => <path d={d} />)}
    </g>
    <g class="frame-lines frame-leader">
      {leaders.map((d) => <path d={d} />)}
    </g>
  </svg>
</div>

<script>
  (function () {
    if (window.__backdrop) return;
    window.__backdrop = true;

    const host = document.querySelector('.backdrop');
    const canvas = document.querySelector('.backdrop-gl');
    if (!(host instanceof HTMLElement) || !(canvas instanceof HTMLCanvasElement)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    function routeName() {
      const path = location.pathname.replace(/\/+$/, '') || '/';
      if (path === '/') return 'home';
      const parts = path.split('/').filter(Boolean);
      return parts[0] === 'work' && parts.length > 1 ? 'project' : parts[0];
    }

    const idle = window.requestIdleCallback ?? ((fn) => setTimeout(fn, 400));
    idle(async () => {
      try {
        const { startBackdrop } = await import('../lib/backdrop');
        const setRoute = startBackdrop(canvas);
        if (!setRoute) return;
        host.classList.add('is-gl');
        setRoute(routeName());
        document.addEventListener('astro:after-swap', () => setRoute(routeName()));
      } catch {}
    });
  })();
</script>
