---
import type { CollectionEntry } from 'astro:content';
import CmsImage from './CmsImage.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  priority?: boolean;
  /** Position in the grid, used to stagger the reveal. */
  index?: number;
}

const { project, priority = false, index = 0 } = Astro.props;
const { title, year, location, category, summary, cover } = project.data;
const meta = [year, location ?? category].filter(Boolean).join(' · ');
---

<article data-reveal style={`--i: ${index}`}>
  <a href={`/work/${project.id}`} class="group block">
    <div class="frame aspect-[4/3] overflow-hidden">
      <CmsImage
        src={cover}
        alt={title}
        class="h-full w-full bg-paper-sunk object-cover transition-opacity duration-300 group-hover:opacity-90"
        aspect="4 / 3"
        layout="full-width"
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        priority={priority}
      />
    </div>

    <div class="mt-5 space-y-1">
      <h3 class="text-sm font-medium tracking-[0.06em] uppercase transition-colors group-hover:text-accent">
        {title}
      </h3>
      {meta && <p class="label">{meta}</p>}
      {summary && <p class="pt-1 text-sm leading-relaxed text-muted">{summary}</p>}
    </div>
  </a>
</article>
