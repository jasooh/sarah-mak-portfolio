---
import type { CollectionEntry } from 'astro:content';
import CmsImage from './CmsImage.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  number?: string;
  priority?: boolean;
  index?: number;
}

const { project, number, priority = false, index = 0 } = Astro.props;
const { title, subtitle, typology, completed, summary, cover, cover_kind } = project.data;
const meta = [completed, typology].filter(Boolean).join(' · ');
---

<article data-reveal style={`--i: ${index}`}>
  <a href={`/work/${project.id}`} class="group block">
    <div class="frame aspect-[4/3] overflow-hidden bg-paper p-3">
      <CmsImage
        src={cover}
        alt={title}
        class:list={[
          'h-full w-full bg-paper-sunk transition-opacity duration-300 group-hover:opacity-90',
          cover_kind === 'drawing' ? 'object-contain' : 'object-cover',
        ]}
        aspect="4 / 3"
        layout="full-width"
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        priority={priority}
      />
    </div>

    <div class="mt-5">
      <h3 class="heading text-sm transition-colors group-hover:text-accent">
        {number && <span class="not-italic text-muted">{number}|&nbsp;</span>}{title}
      </h3>
      {subtitle && <p class="heading mt-0.5 text-xs text-muted">{subtitle}</p>}
      {meta && <p class="label mt-2">{meta}</p>}
      {summary && <p class="mt-2 text-[0.8125rem] leading-relaxed text-muted">{summary}</p>}
    </div>
  </a>
</article>
