---
import { site } from '../lib/site';

const nav = [
  { label: 'Work', href: '/work' },
  { label: 'About', href: '/about' },
  { label: 'CV', href: '/cv' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-6xl flex-wrap items-baseline justify-between gap-x-8 gap-y-3 px-6 py-6 md:px-10">
    <a href="/" class="text-sm font-medium tracking-tight transition-opacity hover:opacity-60">
      {site.name}
      {site.role && <span class="ml-2 font-normal text-muted">{site.role}</span>}
    </a>

    <nav aria-label="Primary">
      <ul class="flex items-baseline gap-6">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={[
                  'text-sm transition-opacity hover:opacity-60',
                  isCurrent(item.href) ? 'text-ink' : 'text-muted',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
