---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CmsImage from '../../components/CmsImage.astro';
import { getProjects, type Project } from '../../lib/projects';

interface Props {
  project: Project;
  previous?: Project;
  next?: Project;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      previous: projects[index - 1],
      next: projects[index + 1],
    },
  }));
};

const { project, previous, next } = Astro.props;
const { title, year, location, category, role, summary, cover, gallery } = project.data;
const { Content } = await render(project);

const facts = [
  { label: 'Year', value: year },
  { label: 'Location', value: location },
  { label: 'Type', value: category },
  { label: 'Role', value: role },
].filter((fact) => Boolean(fact.value));
---

<BaseLayout title={title} description={summary} image={cover}>
  <article>
    <header class="mx-auto max-w-6xl px-6 pt-16 pb-12 md:px-10 md:pt-24">
      <a href="/work" class="label transition-colors hover:text-ink">← Work</a>
      <h1 class="mt-6 max-w-3xl text-2xl leading-tight font-normal tracking-tight md:text-4xl">
        {title}
      </h1>
      {summary && <p class="mt-6 max-w-[52ch] text-base leading-relaxed text-muted">{summary}</p>}
    </header>

    {
      cover && (
        <div class="mx-auto max-w-6xl px-6 md:px-10">
          <CmsImage
            src={cover}
            alt={title}
            class="w-full bg-paper-sunk object-cover"
            aspect="16 / 9"
            layout="full-width"
            priority
          />
        </div>
      )
    }

    <div
      class="mx-auto mt-16 grid max-w-6xl gap-x-12 gap-y-10 px-6 md:grid-cols-[14rem_minmax(0,1fr)] md:px-10"
    >
      {
        facts.length > 0 && (
          <aside>
            <dl class="space-y-4 border-t border-line pt-4">
              {facts.map((fact) => (
                <div>
                  <dt class="label">{fact.label}</dt>
                  <dd class="mt-1 text-sm">{fact.value}</dd>
                </div>
              ))}
            </dl>
          </aside>
        )
      }

      <div class="prose-page border-t border-line pt-4">
        <Content />
      </div>
    </div>

    {
      gallery.length > 0 && (
        <section class="mx-auto mt-20 max-w-6xl space-y-16 px-6 md:px-10">
          {gallery.map((item) => (
            <figure>
              <CmsImage
                src={item.image}
                alt={item.caption ?? ''}
                class="w-full bg-paper-sunk"
                aspect="3 / 2"
                layout="full-width"
              />
              {item.caption && <figcaption class="label mt-3">{item.caption}</figcaption>}
            </figure>
          ))}
        </section>
      )
    }

    {
      (previous || next) && (
        <nav
          class="mx-auto mt-24 flex max-w-6xl items-baseline justify-between gap-6 border-t border-line px-6 pt-6 md:px-10"
          aria-label="More projects"
        >
          {previous ? (
            <a href={`/work/${previous.id}`} class="text-sm text-muted transition-colors hover:text-ink">
              ← {previous.data.title}
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a
              href={`/work/${next.id}`}
              class="text-right text-sm text-muted transition-colors hover:text-ink"
            >
              {next.data.title} →
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>
