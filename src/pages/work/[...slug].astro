---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CmsImage from '../../components/CmsImage.astro';
import Figure from '../../components/Figure.astro';
import { getProjects, projectNumber, type Project } from '../../lib/projects';

interface Props {
  project: Project;
  number: string;
  previous?: Project;
  next?: Project;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      number: projectNumber(project, index),
      previous: projects[index - 1],
      next: projects[index + 1],
    },
  }));
};

const { project, number, previous, next } = Astro.props;
const { title, subtitle, summary, cover, cover_kind, gallery } = project.data;
const { Content } = await render(project);

/* Without a cover there is no second column to fill, so the text takes the
   page on its own rather than sitting in a narrow strip beside empty space. */
const layout = cover ? project.data.layout : 'text';
const sideBySide = layout === 'side';

const facts = [
  ['Typology', project.data.typology],
  ['Location', project.data.location],
  ['Course', project.data.course],
  ['Completed', project.data.completed],
  ['Instructor', project.data.instructor],
].filter(([, value]) => Boolean(value)) as [string, string][];
---

<BaseLayout title={title} description={summary} image={cover}>
  <article>
    <header class="mx-auto max-w-6xl px-6 pt-12 md:px-10 md:pt-16">
      <p data-reveal class="label">
        <a href="/work" class="wipe transition-colors hover:text-accent">Selected Works</a>
        <span class="mx-1.5 text-line">|</span>
        <span class="text-accent">{title}</span>
      </p>

      <h1 data-reveal style="--i: 1" class="heading mt-10 max-w-3xl text-xl md:text-2xl">
        <span class="not-italic text-muted">{number}|</span>&nbsp;{title}
      </h1>
      {
        subtitle && (
          <p data-reveal style="--i: 2" class="heading mt-1 pl-10 text-sm text-muted">
            {subtitle}
          </p>
        )
      }
    </header>

    {
      layout === 'wide' && (
        <div data-reveal class="mx-auto mt-12 max-w-6xl px-6 md:px-10">
          <div class="frame bg-paper p-4">
            <div class="aspect-[16/9] overflow-hidden">
            <CmsImage
              src={cover}
              alt={title}
              class:list={[
                'h-full w-full',
                cover_kind === 'drawing' ? 'object-contain' : 'object-cover',
              ]}
              aspect="16 / 9"
              layout="full-width"
              sizes="(min-width: 1024px) 72rem, 100vw"
              priority
              zoomable
              />
            </div>
          </div>
        </div>
      )
    }

    <div
      class:list={[
        'mx-auto mt-12 grid max-w-6xl gap-x-12 gap-y-10 px-6 md:px-10',
        sideBySide ? 'md:grid-cols-[22rem_minmax(0,1fr)]' : 'md:grid-cols-[14rem_minmax(0,1fr)]',
      ]}
    >
      <div data-reveal>
        {
          facts.length > 0 && (
            <dl class="meta">
              {facts.map(([label, value]) => (
                <div class="flex gap-2">
                  <dt>{label}:</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
          )
        }

        {
          sideBySide && (
            <div class="prose-page mt-8 text-left md:text-justify">
              <Content />
            </div>
          )
        }
      </div>

      {
        sideBySide ? (
          <div data-reveal style="--i: 1">
            <div class="frame bg-paper p-4">
              <div class="aspect-square overflow-hidden">
              <CmsImage
                src={cover}
                alt={title}
                class:list={[
                  'h-full w-full',
                  cover_kind === 'drawing' ? 'object-contain' : 'object-cover',
                ]}
                aspect="1 / 1"
                layout="full-width"
                sizes="(min-width: 768px) 55vw, 100vw"
                priority
                zoomable
                />
              </div>
            </div>
          </div>
        ) : (
          <div data-reveal style="--i: 1" class="prose-page text-left md:text-justify">
            <Content />
          </div>
        )
      }
    </div>

    {
      gallery.length > 0 && (
        <section class="mx-auto mt-20 max-w-6xl px-6 md:px-10">
          <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2">
            {gallery.map((item, index) => (
              <div data-reveal style={`--i: ${index % 2}`}>
                <Figure
                  src={item.image}
                  caption={item.caption}
                  alt={item.caption ?? title}
                  scale={item.scale}
                  kind={item.kind}
                  sizes="(min-width: 640px) 50vw, 100vw"
                />
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      (previous || next) && (
        <nav
          class="rule-t mx-auto mt-24 flex max-w-6xl items-baseline justify-between gap-6 px-6 pt-6 md:px-10"
          aria-label="More projects"
        >
          {previous ? (
            <a href={`/work/${previous.id}`} class="wipe label transition-colors hover:text-accent">
              ← {previous.data.title}
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a
              href={`/work/${next.id}`}
              class="wipe label text-right transition-colors hover:text-accent"
            >
              {next.data.title} →
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>
