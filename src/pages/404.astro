---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="mx-auto max-w-6xl px-6 py-32 md:px-10">
    <p class="label">404</p>
    <h1 class="mt-4 text-2xl font-normal tracking-tight md:text-3xl">This page does not exist.</h1>
    <a
      href="/"
      class="mt-8 inline-block text-sm underline decoration-line underline-offset-4 transition-colors hover:decoration-ink"
    >
      Back to the start
    </a>
  </section>
</BaseLayout>
