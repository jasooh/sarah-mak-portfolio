---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getFeaturedProjects, projectNumber } from '../lib/projects';
import { site } from '../lib/site';

const projects = await getFeaturedProjects();
---

<BaseLayout>
  <section class="mx-auto max-w-6xl px-6 pt-20 pb-16 md:px-10 md:pt-32 md:pb-24">
    <h1 data-reveal class="max-w-3xl text-2xl leading-[1.25] font-normal tracking-tight md:text-4xl">
      {site.tagline ?? site.name}
    </h1>
    {site.intro && <p data-reveal style="--i: 1" class="prose-page mt-8">{site.intro}</p>}
  </section>

  <section class="mx-auto max-w-6xl px-6 md:px-10">
    <div data-reveal class="rule flex items-baseline justify-between pb-3">
      <h2 class="heading text-sm">selected works</h2>
      <a href="/work" class="wipe label transition-colors hover:text-accent">All projects →</a>
    </div>

    {
      projects.length > 0 ? (
        <div class="mt-10 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project, index) => (
            <ProjectCard
              project={project}
              number={projectNumber(project, index)}
              priority={index < 3}
              index={index}
            />
          ))}
        </div>
      ) : (
        <p class="mt-10 text-sm text-muted">Projects will appear here shortly.</p>
      )
    }
  </section>
</BaseLayout>
