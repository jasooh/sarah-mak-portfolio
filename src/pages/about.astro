---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CmsImage from '../components/CmsImage.astro';
import { site } from '../lib/site';

const page = await getEntry('pages', 'about');
if (!page) {
  throw new Error('Missing src/content/pages/about.md');
}
const { Content } = await render(page);
const { title, headline, portrait, portrait_alt } = page.data;
---

<BaseLayout title={title} image={portrait}>
  <section class="mx-auto max-w-6xl px-6 pt-16 md:px-10 md:pt-24">
    <h1 class="text-2xl font-normal tracking-tight md:text-3xl">{title}</h1>

    <div class="mt-14 grid gap-x-12 gap-y-10 md:grid-cols-[18rem_minmax(0,1fr)]">
      <div class="frame h-fit">
        <CmsImage
          src={portrait}
          alt={portrait_alt ?? site.name}
          class="w-full bg-paper-sunk object-cover"
          aspect="3 / 4"
          layout="full-width"
        />
      </div>

      <div>
        {headline && <p class="max-w-[46ch] text-lg leading-relaxed">{headline}</p>}
        <div class="prose-page mt-8">
          <Content />
        </div>

        <div class="rule-t mt-12 flex flex-wrap gap-x-8 gap-y-2 pt-6">
          {
            site.email && (
              <a
                href={`mailto:${site.email}`}
                class="text-sm underline decoration-line underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
              >
                {site.email}
              </a>
            )
          }
          <a href="/cv" class="label transition-colors hover:text-accent">Full CV →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
