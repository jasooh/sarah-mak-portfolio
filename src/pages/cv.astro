---
import BaseLayout from '../layouts/BaseLayout.astro';
import { cv, formatRange } from '../lib/site';

const dated = [
  {
    label: 'academic qualifications',
    entries: cv.academic.map((entry) => ({
      range: formatRange(entry.start, entry.end),
      title: entry.qualification,
      lines: [entry.institution, entry.faculty],
      notes: entry.notes,
    })),
  },
  {
    label: 'activities',
    entries: cv.activities.map((entry) => ({
      range: formatRange(entry.start, entry.end),
      title: entry.role,
      lines: [entry.organisation],
      notes: entry.notes,
    })),
  },
  {
    label: 'experience',
    entries: cv.experience.map((entry) => ({
      range: formatRange(entry.start, entry.end),
      title: entry.role,
      lines: [entry.organisation, entry.location],
      notes: entry.notes,
    })),
  },
  {
    label: 'awards',
    entries: cv.awards.map((entry) => ({
      range: entry.year,
      title: entry.title,
      lines: [entry.issuer],
      notes: entry.notes,
    })),
  },
].filter((section) => section.entries.length > 0);
---

<BaseLayout title="CV">
  <section class="mx-auto max-w-4xl px-6 pt-12 pb-4 md:px-10 md:pt-16">
    <div data-reveal class="flex flex-wrap items-baseline justify-between gap-4">
      <h1 class="heading text-xl md:text-2xl">curriculum vitae</h1>
      {
        cv.pdf && (
          <a href={cv.pdf} class="wipe label transition-colors hover:text-accent" download>
            Download PDF
          </a>
        )
      }
    </div>

    <div class="mt-14 space-y-14">
      {
        cv.expertise.length > 0 && (
          <section>
            <h2 data-reveal class="heading text-sm">expertise</h2>
            <ul class="mt-5 grid gap-x-12 gap-y-1.5 sm:grid-cols-2">
              {cv.expertise.map((item, index) => (
                <li
                  data-reveal="x"
                  style={`--i: ${index}`}
                  class="meta flex justify-between gap-6 border-b border-line/40 pb-1.5"
                >
                  <span>{item.name}</span>
                  {item.duration && <span class="text-muted">{item.duration}</span>}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        dated.map((section) => (
          <section>
            <h2 data-reveal class="heading text-sm">
              {section.label}
            </h2>
            <ul class="mt-5 space-y-6">
              {section.entries.map((entry, index) => (
                <li
                  data-reveal="x"
                  style={`--i: ${index}`}
                  class="meta grid gap-x-8 gap-y-0.5 md:grid-cols-[14rem_minmax(0,1fr)]"
                >
                  <p class="text-muted">{entry.range}</p>
                  <div>
                    <p>{entry.title}</p>
                    {entry.lines.filter(Boolean).map((line) => (
                      <p class="text-muted">{line}</p>
                    ))}
                    {entry.notes && <p class="mt-1.5 text-muted">{entry.notes}</p>}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>
