---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { resolveImage } from '../lib/images';
import { site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Social share image, as a CMS path (e.g. /src/assets/media/cover.jpg). */
  image?: string;
}

const { title, description, image } = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name}${site.role ? ` — ${site.role}` : ''}`;
const pageDescription = description ?? site.seo.description ?? site.tagline;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

// Resize the share image rather than linking the original — a full-resolution
// render is far past what the social platforms will fetch.
const source = resolveImage(image ?? site.seo.image);
const shareImage = source
  ? await getImage({ src: source, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })
  : undefined;
const shareImageUrl = shareImage ? new URL(shareImage.src, Astro.site ?? Astro.url).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    {pageDescription && <meta name="description" content={pageDescription} />}
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    {pageDescription && <meta property="og:description" content={pageDescription} />}
    <meta property="og:url" content={canonical} />
    {
      shareImageUrl && (
        <>
          <meta property="og:image" content={shareImageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta name="twitter:card" content={shareImageUrl ? 'summary_large_image' : 'summary'} />

    <meta name="theme-color" content="#e4e0cd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#4b4840" media="(prefers-color-scheme: dark)" />
  </head>

  <body class="flex min-h-screen flex-col">
    <div class="grain" aria-hidden="true"></div>
    <SiteHeader />
    <main class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
