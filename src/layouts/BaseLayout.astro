---
import { ClientRouter } from 'astro:transitions';
import BuildingBackdrop from '../components/BuildingBackdrop.astro';
import { getImage } from 'astro:assets';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { resolveImage } from '../lib/images';
import { site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name}${site.role ? ` — ${site.role}` : ''}`;
const pageDescription = description ?? site.seo.description ?? site.tagline;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

const source = resolveImage(image ?? site.seo.image);
const shareImage = source
  ? await getImage({ src: source, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })
  : undefined;
const shareImageUrl = shareImage ? new URL(shareImage.src, Astro.site ?? Astro.url).href : undefined;

const iconSource = resolveImage(site.favicon);
let iconHref: string | undefined;
let touchIconHref: string | undefined;
if (iconSource) {
  if (iconSource.format === 'svg') {
    iconHref = iconSource.src;
  } else {
    const [tab, touch] = await Promise.all([
      getImage({ src: iconSource, width: 64, height: 64, fit: 'cover', format: 'png' }),
      getImage({ src: iconSource, width: 180, height: 180, fit: 'cover', format: 'png' }),
    ]);
    iconHref = tab.src;
    touchIconHref = touch.src;
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
      (function () {
        function setRoute() {
          var path = location.pathname.replace(/\/+$/, '') || '/';
          document.documentElement.dataset.route = path === '/' ? 'home' : path.split('/')[1];
        }
        setRoute();
        if (!window.__routeBound) {
          window.__routeBound = true;
          document.addEventListener('astro:after-swap', setRoute);
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    {pageDescription && <meta name="description" content={pageDescription} />}
    <link rel="canonical" href={canonical} />

    {
      iconHref ? (
        <link rel="icon" href={iconHref} />
      ) : (
        <>
          <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
          <link rel="icon" href="/favicon.ico" sizes="32x32" />
        </>
      )
    }
    {touchIconHref && <link rel="apple-touch-icon" href={touchIconHref} />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    {pageDescription && <meta property="og:description" content={pageDescription} />}
    <meta property="og:url" content={canonical} />
    {
      shareImageUrl && (
        <>
          <meta property="og:image" content={shareImageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta name="twitter:card" content={shareImageUrl ? 'summary_large_image' : 'summary'} />

    <meta name="theme-color" content="#e4e0cd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#4b4840" media="(prefers-color-scheme: dark)" />

    <ClientRouter />
  </head>

  <body class="flex min-h-screen flex-col">
    <BuildingBackdrop />
    <div class="grain" aria-hidden="true"></div>
    <SiteHeader />
    <main class="relative z-10 flex-1">
      <slot />
    </main>
    <SiteFooter />

    <script>
      function initReveals() {
        const items = document.querySelectorAll('[data-reveal]:not(.is-revealed)');
        if (items.length === 0) return;

        const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (still || !('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('is-revealed'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.04 },
        );

        items.forEach((el) => observer.observe(el));
      }

      initReveals();
      document.addEventListener('astro:after-swap', initReveals);
      document.addEventListener('astro:page-load', initReveals);
    </script>
  </body>
</html>
